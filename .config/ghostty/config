# omorfos Prism, the brand's terminal palette; the same colours and
# settings as foot.ini, the Konsole profile and nvim's omorfos scheme.

# The brand's monospace face, at the size used in Konsole and foot
font-family = JetBrains Mono
font-size = 12

# Orange, the one brand colour no ANSI slot uses, so it is always findable
cursor-color = #FB923C
cursor-text = #0C1226
# A blinking beam, as in Konsole
cursor-style = bar
cursor-style-blink = true

# See-through like Konsole; blur only works where the compositor offers it
background-opacity = 0.6
background-blur = true

background = #0C1226
foreground = #E6EAF5
selection-background = #243364
selection-foreground = #E6EAF5

