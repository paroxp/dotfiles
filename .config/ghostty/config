# omorfos Prism, the brand's terminal palette, for the main terminal.
# The README lists the other files that share these colours.

# The brand's monospace face
font-family = JetBrains Mono
font-size = 12

# Breathing room so text doesn't sit on the window edge
window-padding-x = 12
window-padding-y = 8
window-padding-balance = true

# Orange, the one brand colour no ANSI slot uses, so it is always findable
cursor-color = #FB923C
cursor-text = #0C1226
cursor-style = bar
cursor-style-blink = true

# See-through; macOS and KDE blur what is behind, other compositors don't
background-opacity = 0.75
background-blur = true

background = #0C1226
foreground = #E6EAF5
selection-background = #243364
selection-foreground = #E6EAF5

palette = 0=#141C38
palette = 1=#F8616D
palette = 2=#84CC16
palette = 3=#FACC15
palette = 4=#60A5FA
palette = 5=#F472B6
palette = 6=#22D3EE
